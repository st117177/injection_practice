# Скопируйте этот файл в .env и впишите ключ. .env в репозиторий не коммитится.

# Формат API: anthropic (курсовой шлюз) или openai (OpenRouter и совместимые)
LLM_PROVIDER=anthropic

# Персональный ключ к курсовому шлюзу (выдаёт преподаватель). Не публикуйте и не коммитьте.
LLM_API_KEY=

# Адрес курсового шлюза
LLM_BASE_URL=https://claude.gigaparsers.ru

# Модель курса
LLM_MODEL=deepseek-flash

# Как передавать ключ на шлюз: x-api-key (по умолчанию) или bearer
LLM_AUTH_SCHEME=x-api-key

# Лимит запросов в минуту на ключ (у шлюза — 10)
LLM_RPM=10

# Температура > 0 нужна, чтобы N запусков различались (для статистики успеха)
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# Для deepseek-flash отключает «размышление», иначе короткий max_tokens уходит в него.
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# --- Вариант через OpenRouter (если нет ключа к шлюзу) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4-flash
# LLM_RPM=0

# --- Опциональный трейсинг в LangSmith (по умолчанию выключен) ---
# Включите, если хотите видеть прогоны в LangSmith и сдавать работу ссылкой.
# Нужен пакет: pip install langsmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hr-agent
