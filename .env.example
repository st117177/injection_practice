# Скопируйте этот файл в .env и впишите ключ. .env в репозиторий не коммитится.

# Формат API: openai (OpenRouter, DeepSeek и др.) или anthropic (шлюз с таким форматом)
LLM_PROVIDER=openai

# Ключ доступа к модели
LLM_API_KEY=

# Адрес API. Для OpenRouter можно не менять.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модель курса
LLM_MODEL=deepseek/deepseek-v4-flash

# Температура > 0 нужна, чтобы N запусков различались (для статистики успеха)
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# Лимит запросов в минуту (0 — без ограничения). На общем ключе поставьте как у шлюза.
LLM_RPM=0

# Если провайдер — anthropic: как передавать ключ (x-api-key или bearer)
LLM_AUTH_SCHEME=x-api-key

# Добавка к телу запроса. Для deepseek-flash отключает «размышление».
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
